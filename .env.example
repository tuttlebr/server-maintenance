# DGX Fleet Manager Configuration
FLEET_PORT=8080
# Bridge one dedicated SSH agent into the web container. The known_hosts file
# is an optional seed; the UI stores approved keys in the fleet-data volume.
SSH_AUTH_SOCK_PATH=
SSH_KNOWN_HOSTS_PATH=./.fleet-ssh/known_hosts
# Optional absolute host path. Required for Kubernetes-aware maintenance in Docker.
# Leave empty to mount /dev/null; non-container Ansible uses $KUBECONFIG or ~/.kube/config.
FLEET_KUBECONFIG_PATH=
APP_ENV=development
SECRET_KEY=
ADMIN_PASSWORD=
# Generate with: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
HOST_SECRET_KEY=
CORS_ORIGINS=http://localhost:8080,http://localhost:5173
ANSIBLE_JOB_TIMEOUT_SECONDS=3600
ANSIBLE_MAX_CONCURRENT_JOBS=4
ANSIBLE_FORKS=10

AI_HELPER_API_KEY=
AI_HELPER_MODEL=aws/anthropic/bedrock-claude-sonnet-4-6
AI_HELPER_BASE_URL=https://inference-api.nvidia.com/v1

# Embedding model for RAG pipeline
EMBED_MODEL=nvidia/qwen/qwen3-embedding-0.6b
EMBED_DIM=1024
# Optional: override AI_HELPER_* for document embeddings
# EMBED_API_KEY=
# EMBED_BASE_URL=https://inference-api.nvidia.com/v1

# Milvus for Rust doc ingester (host default; docker network uses http://milvus:19530)
MILVUS_URI=http://localhost:19530
# MILVUS_TOKEN=root:Milvus
DOCS_URLS_FILE=/app/docs/urls.txt
DOCS_MARKDOWN_DIR=/app/data/docs-crawled
DOCS_INGESTER_BIN=/usr/local/bin/fleet-doc-ingester

# NeMo Agent Toolkit (set automatically in docker-compose)
NAT_BASE_URL=http://nat:8000
